flowchart TB
  classDef prop fill:#E8F3F4,stroke:#0B6E78,color:#15212B
  classDef gate fill:#FFF0D2,stroke:#8F5400,color:#15212B
  classDef stop fill:#FADFDF,stroke:#A02A2A,color:#15212B
  classDef ok fill:#DCF2E5,stroke:#1D7447,color:#15212B
  classDef out fill:#FFFFFF,stroke:#55626E,color:#15212B,stroke-dasharray: 5 4

  subgraph L1["เลน 1  ผู้ใช้ในทีม เตรียมไฟล์"]
    direction LR
    A["1. เลือกชนิดเอกสาร<br/>เห็นเฉพาะชนิดที่เผยแพร่แล้ว<br/>และเป็นของทีมตนเอง"]:::prop
    B["2. ดาวน์โหลดไฟล์ Excel แม่แบบ<br/>กรอก หนึ่งแถวต่อหนึ่งจดหมาย"]:::prop
    C["3. อัปโหลดไฟล์"]:::prop
    A --> B --> C
  end

  subgraph L2["เลน 2  ระบบรับและตรวจข้อมูล"]
    direction LR
    D["4. เปิดรอบงานใหม่<br/>ล็อกเวอร์ชันแบบฟอร์มและกติกา<br/>จดลายนิ้วมือไฟล์ เวลา ผู้อัปโหลด"]:::prop
    E{"5. ตรวจไฟล์<br/>เปิดได้? หัวคอลัมน์ตรงแม่แบบ?"}:::gate
    F["หยุดทั้งรอบ บอกสาเหตุเป็นไทย<br/>กลับไปเลน 1 ข้อ 3"]:::stop
    G["6. ตรวจทีละแถว<br/>ผล: พร้อมสร้าง / ต้องแก้ไข / ข้าม"]:::prop
    I["แถวที่ต้องแก้ไข: แสดง รายการที่ต้องแก้<br/>แถวที่ ช่อง วิธีแก้ แล้วกลับไปเลน 1 ข้อ 2"]:::stop
    J{"7. ซ้ำกับรอบงานก่อนหน้า?<br/>เทียบรายงานสรุปรอบก่อน"}:::gate
    K["ซ้ำ: ต้องเลือก ใช้ของเดิม<br/>หรือสร้างใหม่พร้อมเหตุผล<br/>ไม่เลือกก็ไปต่อไม่ได้"]:::gate
    D --> E
    E -->|ผ่าน| G
    E -->|ไม่ผ่าน| F
    G --> I
    G --> J
    J -->|ซ้ำ| K
  end

  subgraph L3["เลน 3  สร้างจดหมาย ตรวจ และอนุมัติ"]
    direction LR
    L["8. สร้างจดหมายทีละฉบับ<br/>ตรวจข้อความหลังสร้าง<br/>ไม่ผ่าน = สร้างไม่สำเร็จ"]:::prop
    M["9. ผู้ใช้ดูตัวอย่าง<br/>เทียบจำนวนกับที่คาด"]:::prop
    N["10. กด ขออนุมัติ"]:::prop
    O{"ผู้อนุมัติตรวจตัวอย่าง<br/>และรายการยกเว้น"}:::gate
    P["ไม่อนุมัติ: กลับไปแก้<br/>พร้อมเหตุผล"]:::stop
    Q["11. อนุมัติแล้ว: ดาวน์โหลดจดหมาย<br/>และรายงานสรุปรอบงาน<br/>เฉพาะผู้มีสิทธิ์"]:::ok
    L --> M --> N --> O
    O -->|ไม่| P
    O -->|ใช่| Q
  end

  subgraph L4["เลน 4  ส่งมอบและบันทึก"]
    direction LR
    R["12. ทีมที่ได้รับมอบหมายส่งถึงลูกค้า<br/>ตามช่องทางที่ตกลง TO CONFIRM<br/>อยู่นอกระบบนี้"]:::out
    LOG["บันทึกตรวจสอบ ทุกขั้น: ใคร ทำอะไร<br/>เมื่อไร เวอร์ชันไหน"]:::out
  end

  L1 --> L2
  L2 --> L3
  L3 --> L4
