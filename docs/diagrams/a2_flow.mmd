flowchart TB
  classDef sys fill:#E8F3F4,stroke:#0B6E78,color:#15212B
  classDef gate fill:#FFF0D2,stroke:#8F5400,color:#15212B
  classDef bad fill:#FADFDF,stroke:#A02A2A,color:#15212B
  classDef ok fill:#DCF2E5,stroke:#1D7447,color:#15212B
  classDef human fill:#EDE7F6,stroke:#5B3FA0,color:#15212B

  subgraph L1["เลน 1  ระบบ: อ่านและตรวจข้อมูล"]
    direction LR
    A["1. อ่าน Excel เป็นข้อความ<br/>ไม่ให้โปรแกรมเดาชนิดข้อมูล"]:::sys
    B["2. ตรวจไฟล์<br/>แผ่นงาน Sheet1<br/>หัวคอลัมน์ 7 ตัว"]:::sys
    C["3. ตรวจรายแถว<br/>ค่าครบ วันที่ ลำดับวันที่<br/>สถานะ รายการเอกสาร ชื่อเอกสาร"]:::sys
    D{"4. คัดแถว<br/>สถานะเป็น REQUEST_DOC<br/>และข้อมูลถูกต้อง?"}:::gate
    R["แถวผิด: ไม่สร้างจดหมาย<br/>บันทึกใน rejected.csv<br/>ข้อความภาษาไทย"]:::bad
    S["แถวข้าม: สถานะอื่น<br/>ถ้ายังมีรายการเอกสาร<br/>ขึ้นรายงาน<br/>ข้อมูลขัดแย้ง<br/>ตรวจสอบ"]:::gate
    U["แถวซ้ำ: สร้างฉบับเดียว<br/>รายงานเลขแถวทั้งสอง"]:::gate
    A --> B --> C --> D
    C -.-> R
    D -.-> S
    D -.-> U
  end

  subgraph L2["เลน 2  ระบบ: สร้างจดหมายและตรวจ PDF"]
    direction LR
    E["5. ปรับค่า<br/>คุณ ครั้งเดียว<br/>โรงพยาบาล ครั้งเดียว<br/>วันที่ พ.ศ.<br/>ชื่อเอกสารเป็นไทย"]:::sys
    F["6. เติมแบบฟอร์ม HTML<br/>escape ข้อมูลทุกค่า<br/>ไม่ใช้ LLM"]:::sys
    G["7. พิมพ์เป็น PDF<br/>Chrome + ฟอนต์ Sarabun<br/>ฝังในไฟล์"]:::sys
    H{"8. ตรวจข้อความใน PDF<br/>ตรงกับบรรทัดที่ควรเป็น<br/>ทุกบรรทัด?"}:::gate
    X["ไม่ผ่าน: ลบ PDF<br/>บันทึกในรายงานว่า<br/>สร้างไม่สำเร็จ"]:::bad
    E --> F --> G --> H
    H -.-> X
  end

  subgraph L3["เลน 3  คน: ตรวจและปล่อย"]
    direction LR
    I["9. เขียน manifest และรายงาน<br/>กระทบยอดจำนวนแถว<br/>โฟลเดอร์ใหม่ทุกรอบ"]:::sys
    J["10. คนตรวจ<br/>ตัวอย่างจดหมาย 3 ถึง 5 ฉบับ<br/>และรายการที่มีปัญหา"]:::human
    K{"อนุมัติ?"}:::gate
    N["ไม่อนุมัติ: แก้ไฟล์ต้นทาง<br/>แล้วรันใหม่เป็นรอบใหม่"]:::bad
    L["11. ปล่อยให้ทีมที่ได้รับมอบหมาย<br/>การส่งถึงลูกค้าเป็นขั้นตอนแยก<br/>นอกเครื่องมือนี้"]:::ok
    I --> J --> K
    K -->|ไม่| N
    K -->|ใช่| L
  end

  L1 --> L2
  L2 --> L3
